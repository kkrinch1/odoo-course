#. module: hr_hospital
#: model:hr.hospital.disease,symptoms:hr_hospital.disease_covid19
msgid "Fever, cough, fatigue, shortness of breath."
msgstr "Гарячка, кашель, втома, задишка."

#. module: hr_hospital
#: model:hr.hospital.disease,symptoms:hr_hospital.disease_cat_bacterial
msgid "General category for bacterial infections."
