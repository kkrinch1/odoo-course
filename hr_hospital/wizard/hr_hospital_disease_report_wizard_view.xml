<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Disease report wizard -->
        <record id="view_disease_report_wizard_form" model="ir.ui.view">
            <field name="name">disease.report.wizard.form</field>
            <field name="model">disease.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Disease Report">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="report_type"/>
                            <field name="group_by" invisible="report_type == 'detailed'"/>
                        </group>
                        <group>
                            <field name="disease_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="doctor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="country_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="only_approved"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_open_results" type="object" string="Open Results" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Regular wizard action -->
        <record id="action_disease_report_wizard" model="ir.actions.act_window">
            <field name="name">Disease Report</field>
            <field name="res_model">disease.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Print binding: Doctor -> Print -> Disease Report -->
        <record id="action_disease_report_wizard_print_binding" model="ir.actions.act_window">
            <field name="name">Disease Report</field>
            <field name="res_model">disease.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
            <field name="binding_view_types">list,form</field>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>